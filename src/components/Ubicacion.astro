---
import SectionHeading from "./SectionHeading.astro";
import Reveal from "./Reveal.astro";
import Button from "./Button.astro";
import { waLink } from "../lib/whatsapp";

import ShoppingBag from "@lucide/astro/icons/shopping-bag";
import Route from "@lucide/astro/icons/route";
import Building from "@lucide/astro/icons/building";
import TrendingUp from "@lucide/astro/icons/trending-up";
import Leaf from "@lucide/astro/icons/leaf";

const points = [
  { icon: ShoppingBag, label: "Cercanía con servicios y comercios" },
  { icon: Route, label: "Conectividad hacia las principales vialidades" },
  { icon: Building, label: "Entorno residencial en crecimiento" },
  { icon: TrendingUp, label: "Alta demanda y plusvalía" },
  { icon: Leaf, label: "Calidad de vida y tranquilidad" },
];

const mapSrc =
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d6161.713903430529!2d-89.6647083!3d21.0643874!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x8f56756ff02b7f15%3A0x73a7634f3b9cd9b0!2sOX%20Tres%20Residencias%20Privadas!5e0!3m2!1ses-419!2smx!4v1782519540555!5m2!1ses-419!2smx";
---

<section id="ubicacion" class="bg-white/30 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center">
      <div>
        <SectionHeading
          eyebrow="Ubicación · Zona Norte de Mérida"
          title="Vive en la Zona Norte de Mérida."
          intro="Dzityá, una de las zonas con mayor crecimiento, plusvalía y proyección residencial del norte de Mérida."
        />
        <Reveal delay={0.1}>
          <ul class="mt-9 grid grid-cols-1 gap-4 sm:grid-cols-2">
            {
              points.map(({ icon: Icon, label }) => (
                <li class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-verde/10 text-verde">
                    <Icon size={20} stroke-width={1.6} aria-hidden="true" />
                  </span>
                  <span class="text-sm font-medium text-carbon/85">{label}</span>
                </li>
              ))
            }
          </ul>
          <p class="mt-8 font-display text-lg font-light leading-snug text-carbon/85">
            La ubicación de una casa también define gran parte de su valor futuro.
          </p>
          <Button href={waLink()} class="mt-7">Agenda una visita y conoce OX</Button>
        </Reveal>
      </div>

      <Reveal delay={0.1}>
        <div class="overflow-hidden rounded-2xl border border-greige/40 shadow-sm">
          <iframe
            title="Ubicación de OX Tres Residencias Privadas, Dzityá, Mérida"
            src={mapSrc}
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            class="h-[420px] w-full lg:h-[520px]"
            allowfullscreen></iframe>
        </div>
      </Reveal>
    </div>
  </div>
</section>
