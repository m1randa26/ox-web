---
import { Image } from "astro:assets";
import Eyebrow from "./Eyebrow.astro";
import Send from "@lucide/astro/icons/send";
import fachada from "../assets/renders/fachada-principal.webp";

const input =
  "mt-1.5 w-full min-h-[48px] rounded-xl border border-greige/60 bg-white/70 px-4 text-base text-grafito placeholder-carbon/40 transition-all duration-200 hover:border-greige focus:border-verde focus:bg-white focus:outline-none focus:ring-4 focus:ring-verde/10 aria-[invalid=true]:border-red-500 aria-[invalid=true]:ring-red-500/10";
---

<section id="contacto" class="bg-white/30 py-24 sm:py-32">
  <div class="mx-auto max-w-7xl px-5 sm:px-8">
    <div class="overflow-hidden rounded-3xl border border-greige/40 bg-marfil shadow-sm lg:grid lg:grid-cols-2">
      <div class="relative hidden min-h-[440px] lg:block">
        <Image
          src={fachada}
          alt="Te damos la bienvenida a OX Residencial"
          widths={[384, 640, 828, 1080, 1200, 1920, 2000]}
          sizes="50vw"
          class="absolute inset-0 h-full w-full object-cover"
        />
      </div>

      <div class="p-8 sm:p-12">
        <Eyebrow size="xs">Agenda tu visita</Eyebrow>
        <h2 class="mt-4 font-display text-3xl font-semibold leading-tight tracking-display text-grafito">
          Agenda una visita y conoce OX en persona.
        </h2>
        <p class="mt-3 text-base leading-relaxed text-carbon/75">
          Déjanos tus datos y nuestro equipo te contactará para coordinar tu visita a OX.
        </p>

        <form id="contact-form" novalidate class="mt-8 space-y-5" action="/api/contacto" method="post">
          <div>
            <label for="name" class="text-sm font-medium text-carbon">Nombre <span class="text-oro">*</span></label>
            <input id="name" name="name" type="text" autocomplete="name" placeholder="Tu nombre completo" class={input} aria-invalid="false" />
            <p id="err-name" role="alert" class="mt-1 text-xs text-red-600" hidden></p>
          </div>
          <div>
            <label for="phone" class="text-sm font-medium text-carbon">Teléfono <span class="text-oro">*</span></label>
            <input id="phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="999 123 4567" class={input} aria-invalid="false" />
            <p id="err-phone" role="alert" class="mt-1 text-xs text-red-600" hidden></p>
          </div>
          <div>
            <label for="email" class="text-sm font-medium text-carbon">Correo electrónico</label>
            <input id="email" name="email" type="email" inputmode="email" autocomplete="email" placeholder="tu@correo.com" class={input} aria-invalid="false" />
            <p id="err-email" role="alert" class="mt-1 text-xs text-red-600" hidden></p>
          </div>
          <div>
            <label for="city" class="text-sm font-medium text-carbon">Ciudad de origen</label>
            <input id="city" name="city" type="text" autocomplete="address-level2" placeholder="Tu ciudad" class={input} />
          </div>

          <fieldset>
            <legend class="text-sm font-medium text-carbon">¿Buscas para?</legend>
            <div class="mt-2 flex gap-3">
              {
                ["Vivir", "Invertir"].map((v) => (
                  <label class="intent-option flex flex-1 cursor-pointer items-center justify-center gap-2 rounded-xl border border-greige/60 px-4 py-3 text-sm font-medium text-carbon/75 transition-colors hover:border-verde/50">
                    <input type="radio" name="intent" value={v} class="sr-only" />
                    {v}
                  </label>
                ))
              }
            </div>
          </fieldset>

          <div class="absolute left-[-9999px]" aria-hidden="true">
            <label for="website">No llenar este campo</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <button
            type="submit"
            class="inline-flex min-h-[52px] w-full items-center justify-center gap-2 rounded-full bg-verde px-8 text-sm font-medium tracking-wide text-marfil transition-all duration-200 hover:bg-verde-700 hover:shadow-lg disabled:cursor-not-allowed disabled:opacity-60"
          >
            <Send size={18} aria-hidden="true" /><span data-label>Agenda una visita y conoce OX</span>
          </button>

          <div data-status="sent" role="status" class="rounded-xl border border-verde/20 bg-verde/5 px-4 py-3 text-center text-sm text-verde" hidden>
            <p class="font-medium">¡Listo! Abrimos WhatsApp con tu mensaje; solo presiona enviar.</p>
            <p class="mt-1 text-xs text-carbon/70">
              ¿No se abrió? <a data-wa-fallback href="#" target="_blank" rel="noopener noreferrer" class="font-medium text-verde underline underline-offset-2">Abrir WhatsApp</a>
            </p>
          </div>
          <p class="text-center text-xs text-carbon/55">Al enviar, se abrirá WhatsApp con tus datos listos para nuestro equipo de ventas.</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { leadLink } from "../lib/whatsapp";

  const form = document.querySelector<HTMLFormElement>("#contact-form")!;
  const $ = <T extends HTMLElement>(sel: string) => form.querySelector<T>(sel)!;
  const fields = {
    name: $<HTMLInputElement>("#name"),
    phone: $<HTMLInputElement>("#phone"),
    email: $<HTMLInputElement>("#email"),
    city: $<HTMLInputElement>("#city"),
    website: $<HTMLInputElement>("#website"),
  };
  const sent = $<HTMLElement>('[data-status="sent"]');
  const fallback = $<HTMLAnchorElement>("[data-wa-fallback]");

  type Errors = Partial<Record<"name" | "phone" | "email", string>>;

  function validate(): Errors {
    const e: Errors = {};
    const name = fields.name.value.trim();
    const phone = fields.phone.value.trim();
    const email = fields.email.value.trim();
    if (!name) e.name = "Ingresa tu nombre.";
    if (!phone) e.phone = "Ingresa tu teléfono.";
    else if (!/^[\d\s()+-]{7,}$/.test(phone)) e.phone = "Teléfono no válido.";
    if (email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) e.email = "Correo no válido.";
    return e;
  }

  function showErrors(e: Errors) {
    (["name", "phone", "email"] as const).forEach((k) => {
      const input = fields[k];
      const msg = form.querySelector<HTMLElement>(`#err-${k}`)!;
      const err = e[k];
      input.setAttribute("aria-invalid", String(!!err));
      if (err) input.setAttribute("aria-describedby", `err-${k}`);
      else input.removeAttribute("aria-describedby");
      msg.textContent = err ?? "";
      msg.hidden = !err;
    });
  }

  [fields.name, fields.phone, fields.email].forEach((i) => i.addEventListener("blur", () => showErrors(validate())));

  form.addEventListener("submit", (ev) => {
    ev.preventDefault();
    sent.hidden = true;
    const e = validate();
    showErrors(e);
    if (Object.keys(e).length) {
      fields[(Object.keys(e)[0] as keyof Errors)].focus();
      return;
    }
    // Honeypot: un bot llenó el campo oculto → no se abre nada.
    if (fields.website.value) return;

    const lead = {
      name: fields.name.value.trim(),
      phone: fields.phone.value.trim(),
      email: fields.email.value.trim(),
      city: fields.city.value.trim(),
      intent: form.querySelector<HTMLInputElement>('input[name="intent"]:checked')?.value ?? "",
    };
    const url = leadLink(lead);

    // Se abre de inmediato (dentro del gesto del usuario) para que el navegador no lo bloquee.
    const win = window.open(url, "_blank");
    if (win) win.opener = null;
    else window.location.href = url; // ventana emergente bloqueada → misma pestaña

    // Respaldo opcional del lead en el servidor (no bloquea ni muestra errores).
    try {
      fetch("/api/contacto", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ ...lead, website: "" }),
        keepalive: true,
      }).catch(() => {});
    } catch {
      /* sin respaldo */
    }

    fallback.href = url;
    sent.hidden = false;
    form.reset();
  });
</script>
