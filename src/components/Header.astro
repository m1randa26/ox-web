---
import { Image } from "astro:assets";
import Menu from "@lucide/astro/icons/menu";
import X from "@lucide/astro/icons/x";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import logo from "../assets/logo-ox.png";
import { waLink } from "../lib/whatsapp";

const links = [
  { href: "#smart-living", label: "Smart Living" },
  { href: "#hogar", label: "Tu Nuevo Hogar" },
  { href: "#ubicacion", label: "Ubicación" },
  { href: "#ostech", label: "OSTECH Desarrolladora" },
];
const wa = waLink();
---

<header class="site-header fixed inset-x-0 top-0 z-40 px-3 pt-3 sm:px-5 sm:pt-4" data-scrolled="false" data-menu-open="false">
  <div class="nav-shell mx-auto max-w-6xl rounded-3xl">
    <div class="flex items-center justify-between gap-4 py-1.5 pl-4 pr-2.5 sm:pl-6 sm:pr-3 lg:py-2">
      <a href="#inicio" aria-label="Inicio — OX Residencial" class="shrink-0">
        <Image
          src={logo}
          alt="OX Tres Residencias Privadas — Dzityá, Mérida"
          width={130}
          densities={[1, 2, 3]}
          loading="eager"
          fetchpriority="high"
          class="brand-logo w-auto object-contain"
        />
      </a>

      <nav class="hidden items-center gap-9 xl:gap-11 lg:flex" aria-label="Principal">
        {
          links.map((l) => (
            <a href={l.href} data-section={l.href.slice(1)} class="nav-link whitespace-nowrap text-[0.95rem] font-medium transition-colors">
              {l.label}
            </a>
          ))
        }
      </nav>

      <div class="flex items-center gap-2">
        <a
          href={wa}
          target="_blank"
          rel="noopener noreferrer"
          class="group hidden min-h-[48px] items-center gap-1.5 rounded-full bg-verde px-6 text-[0.95rem] font-medium text-marfil transition-colors hover:bg-verde-700 sm:inline-flex"
        >
          Conoce OX
          <ArrowUpRight size={17} class="cta-arrow" aria-hidden="true" />
        </a>
        <button
          type="button"
          aria-label="Abrir menú"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="menu-toggle flex h-12 w-12 items-center justify-center rounded-full text-carbon transition-colors hover:bg-greige/20 lg:hidden"
        >
          <Menu size={26} class="icon-open" aria-hidden="true" />
          <X size={26} class="icon-close" aria-hidden="true" />
        </button>
      </div>
    </div>

    <nav id="mobile-menu" class="mobile-menu lg:hidden" aria-label="Menú móvil">
      <div>
        <div class="flex flex-col border-t border-greige/30 px-4 pb-4 pt-2 sm:px-6">
          {
            links.map((l) => (
              <a
                href={l.href}
                data-close-menu
                tabindex="-1"
                class="flex items-center justify-between border-b border-greige/25 py-3.5 font-display text-lg font-medium text-grafito transition-colors last:border-0 hover:text-verde"
              >
                {l.label}
                <span class="text-oro" aria-hidden="true">→</span>
              </a>
            ))
          }
          <a
            href={wa}
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            class="mt-3 inline-flex min-h-[48px] items-center justify-center rounded-full bg-verde px-5 text-sm font-medium text-marfil"
            >Agenda una visita</a
          >
        </div>
      </div>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const menu = header.querySelector<HTMLElement>("#mobile-menu")!;
  const menuLinks = [...menu.querySelectorAll<HTMLAnchorElement>("a")];

  const onScroll = () => {
    header.dataset.scrolled = String(window.scrollY > 24);
  };
  onScroll();
  window.addEventListener("scroll", onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    header.dataset.menuOpen = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
    menuLinks.forEach((a) => (a.tabIndex = open ? 0 : -1));
  };
  toggle.addEventListener("click", () => setOpen(header.dataset.menuOpen !== "true"));
  menu.querySelectorAll("[data-close-menu]").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && header.dataset.menuOpen === "true") setOpen(false);
  });

  // Sección activa en la navegación
  const navLinks = [...header.querySelectorAll<HTMLAnchorElement>(".nav-link[data-section]")];
  const sections = navLinks
    .map((a) => document.getElementById(a.dataset.section!))
    .filter((s): s is HTMLElement => !!s);
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          navLinks.forEach((a) => a.setAttribute("aria-current", String(a.dataset.section === entry.target.id)));
        }
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    sections.forEach((s) => io.observe(s));
    // Fuera de las secciones del menú (hero / contacto) no se marca ninguna
    const clear = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) navLinks.forEach((a) => a.setAttribute("aria-current", "false"));
      },
      { rootMargin: "-45% 0px -50% 0px" },
    );
    ["inicio", "contacto"].forEach((id) => {
      const el = document.getElementById(id);
      if (el) clear.observe(el);
    });
  }
</script>
