---
/**
 * Aparición al hacer scroll (sustituye a Framer Motion).
 * La animación es CSS (.reveal en global.css); este script solo marca
 * .is-visible una vez cuando el bloque entra en pantalla (margen -80px).
 */
interface Props {
  delay?: number;
  class?: string;
}
const { delay = 0, class: className = "" } = Astro.props;
---

<div class:list={["reveal", className]} style={delay ? `--reveal-delay:${delay}s` : undefined}>
  <slot />
</div>

<script>
  const els = document.querySelectorAll<HTMLElement>(".reveal:not(.is-visible)");
  if (!("IntersectionObserver" in window)) {
    els.forEach((el) => el.classList.add("is-visible"));
  } else {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            entry.target.classList.add("is-visible");
            io.unobserve(entry.target);
          }
        }
      },
      { rootMargin: "-80px 0px -80px 0px" },
    );
    els.forEach((el) => io.observe(el));
  }
</script>
