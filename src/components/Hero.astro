---
import { getImage } from "astro:assets";
import MapPin from "@lucide/astro/icons/map-pin";
import BedDouble from "@lucide/astro/icons/bed-double";
import WavesHorizontal from "@lucide/astro/icons/waves-horizontal";
import Sun from "@lucide/astro/icons/sun";
import Cpu from "@lucide/astro/icons/cpu";
import ArrowRight from "@lucide/astro/icons/arrow-right";
import fachada from "../assets/renders/fachada-principal.webp";
import { waLink } from "../lib/whatsapp";

const poster = await getImage({ src: fachada, width: 1920, format: "webp" });

const chips = [
  { icon: BedDouble, label: "3 Recámaras" },
  { icon: WavesHorizontal, label: "Alberca" },
  { icon: Sun, label: "Paneles Solares" },
  { icon: Cpu, label: "Smart Home" },
];
---

<section id="inicio" class="relative flex min-h-[100svh] items-end overflow-hidden bg-grafito">
  <video
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster.src}
    class="hero-media absolute inset-0 h-full w-full object-cover object-center"
  >
    <source src="/media/video-ox-cortado.mp4" type="video/mp4" />
  </video>
  <!-- Doble degradado: oscurece la zona del texto (izquierda y abajo) y deja ver la arquitectura a la derecha -->
  <div class="hero-scrim absolute inset-0"></div>

  <div class="relative z-10 mx-auto w-full max-w-7xl px-5 pb-20 pt-36 sm:px-8 sm:pb-24">
    <div class="hero-text-shadow max-w-2xl lg:max-w-3xl">
      <p
        class="hero-in mb-5 inline-flex items-center gap-2 rounded-full border border-marfil/20 bg-grafito/35 py-1.5 pl-2.5 pr-4 text-sm font-medium text-marfil/95 backdrop-blur-md sm:text-base"
        style="--d:.15s"
      >
        <MapPin size={18} class="text-oro-300" aria-hidden="true" />Zona Norte de Mérida, Yucatán
      </p>
      <h1
        class="hero-in font-display text-[2.6rem] font-semibold leading-[1.02] tracking-display text-marfil sm:text-6xl xl:text-7xl"
        style="--d:.3s"
      >
        Vive en una Smart Home<br /><span class="text-oro-300">diseñada para el futuro.</span>
      </h1>
      <p class="hero-in mt-6 max-w-xl text-base leading-relaxed text-marfil/90 sm:text-lg" style="--d:.45s">
        Tecnología, seguridad y eficiencia energética en residencias contemporáneas ubicadas en la Zona Norte de Mérida.
      </p>

      <div class="hero-in mt-7 flex flex-wrap items-center gap-x-3 gap-y-3" style="--d:.6s">
        <span class="rounded-full bg-oro px-5 py-2 text-sm font-semibold text-grafito shadow-sm">Desde $4.4 MDP*</span>
        <div class="flex flex-wrap gap-2">
          {
            chips.map(({ icon: Icon, label }) => (
              <span class="inline-flex items-center gap-1.5 rounded-full border border-marfil/25 bg-grafito/35 px-3.5 py-2 text-xs font-medium text-marfil backdrop-blur-md">
                <Icon size={15} class="text-oro-300" aria-hidden="true" />
                {label}
              </span>
            ))
          }
        </div>
      </div>

      <div class="hero-in mt-9 flex flex-col gap-3 sm:flex-row sm:items-center" style="--d:.75s">
        <a
          href={waLink()}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex min-h-[54px] items-center justify-center gap-2 rounded-full bg-verde px-8 text-sm font-medium tracking-wide text-marfil shadow-lg shadow-black/25 ring-1 ring-marfil/10 transition-all duration-200 hover:bg-verde-700 hover:shadow-xl"
        >
          Agenda una Visita y Conoce OX
          <ArrowRight size={18} class="cta-arrow" aria-hidden="true" />
        </a>
        <a
          href="#hogar"
          class="inline-flex min-h-[54px] items-center justify-center rounded-full border border-marfil/35 px-7 text-sm font-medium tracking-wide text-marfil backdrop-blur-sm transition-colors hover:border-marfil/70 hover:bg-marfil/10"
        >
          Conoce la residencia
        </a>
      </div>
    </div>
  </div>

  <a
    href="#smart-living"
    aria-label="Desplázate para ver más"
    class="hero-in absolute bottom-6 left-1/2 z-10 hidden -translate-x-1/2 sm:block"
    style="--d:1.1s"
  >
    <span class="flex h-10 w-6 justify-center rounded-full border-2 border-marfil/60 pt-2 transition-colors hover:border-marfil">
      <span class="scroll-cue-dot block h-2 w-1 rounded-full bg-marfil"></span>
    </span>
  </a>
</section>
