---
import { Image, getImage } from "astro:assets";
import ZoomIn from "@lucide/astro/icons/zoom-in";
import X from "@lucide/astro/icons/x";
import planta from "../assets/renders/planta.webp";

const alt =
  "Plano arquitectónico de la residencia OX: planta baja con alberca, terraza, sala, comedor, cocina, recámara 1, baño y cochera para 2 autos; planta alta con recámara principal, walking closet, family room, recámara 2, baño y vestidor.";
const full = await getImage({ src: planta, width: planta.width, format: "webp" });
---

<button
  type="button"
  data-plan-open
  aria-label="Ampliar plano arquitectónico"
  class="group relative mx-auto mt-10 block max-w-3xl overflow-hidden rounded-2xl border border-greige/40 bg-white p-4 shadow-sm transition-shadow hover:shadow-md sm:p-8"
>
  <Image
    src={planta}
    alt={alt}
    widths={[640, 828, 1080, 1200, 1920]}
    sizes="(max-width: 768px) 90vw, 700px"
    class="mx-auto h-auto w-full max-w-xl"
  />
  <span
    class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full bg-grafito/80 px-3 py-1.5 text-xs font-medium text-marfil opacity-0 transition-opacity duration-200 group-hover:opacity-100"
  >
    <ZoomIn size={14} aria-hidden="true" />Ampliar plano
  </span>
</button>

<dialog
  class="ox-dialog ox-plan-dialog fixed inset-0 z-[70] items-center justify-center p-4 open:flex sm:p-8"
  aria-label="Plano arquitectónico"
>
  <button
    type="button"
    data-close
    aria-label="Cerrar"
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-marfil/10 text-marfil hover:bg-marfil/20"
  >
    <X size={24} aria-hidden="true" />
  </button>
  <div data-zoom-box class="relative max-h-[88vh] max-w-4xl overflow-hidden rounded-xl bg-white">
    <img
      data-src={full.src}
      alt={alt}
      draggable="false"
      class="plan-zoom-img max-h-[88vh] w-auto select-none"
    />
  </div>
  <p class="pointer-events-none absolute bottom-5 left-0 right-0 text-center text-xs text-marfil/60">
    Pasa el cursor para hacer zoom · toca la imagen en móvil
  </p>
</dialog>

<script>
  import { lockScroll, unlockScroll } from "../scripts/scroll-lock";

  const dialog = document.querySelector<HTMLDialogElement>(".ox-plan-dialog")!;
  const box = dialog.querySelector<HTMLElement>("[data-zoom-box]")!;
  const img = box.querySelector<HTMLImageElement>("img")!;

  const setZoom = (on: boolean) => img.classList.toggle("is-zoomed", on);

  document.querySelector("[data-plan-open]")!.addEventListener("click", () => {
    if (!img.src) img.src = img.dataset.src!;
    setZoom(false);
    dialog.showModal();
    lockScroll();
  });
  dialog.addEventListener("close", () => {
    setZoom(false);
    unlockScroll();
  });
  dialog.addEventListener("click", (e) => {
    if (e.target === dialog) dialog.close();
  });
  dialog.querySelector("[data-close]")!.addEventListener("click", () => dialog.close());

  box.addEventListener("mousemove", (e) => {
    const r = box.getBoundingClientRect();
    const x = Math.max(0, Math.min(100, ((e.clientX - r.left) / r.width) * 100));
    const y = Math.max(0, Math.min(100, ((e.clientY - r.top) / r.height) * 100));
    img.style.transformOrigin = `${x}% ${y}%`;
  });
  box.addEventListener("mouseenter", () => setZoom(true));
  box.addEventListener("mouseleave", () => setZoom(false));
  box.addEventListener("click", (e) => {
    e.stopPropagation();
    const r = box.getBoundingClientRect();
    img.style.transformOrigin = `${((e.clientX - r.left) / r.width) * 100}% ${((e.clientY - r.top) / r.height) * 100}%`;
    setZoom(!img.classList.contains("is-zoomed"));
  });
</script>
